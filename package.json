{
  "name": "multi-model-for-copilot",
  "displayName": "Multi-Model BYOK for Copilot Chat",
  "description": "Pick DeepSeek V4.1, MiMo V2.5, and Qwen models from the Copilot Chat model picker. Vision, thinking mode, agent tools — zero config, BYOK.",
  "icon": "resources/icon.png",
  "version": "0.7.0",
  "publisher": "WindSnowLi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WindSnowLi/multi-model-for-copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "deepseek",
    "deepseek v4",
    "mimo",
    "xiaomi",
    "multi-model",
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "multi-model",
        "displayName": "Multi-Model"
      }
    ],
    "commands": [
      {
        "command": "multi-model-for-copilot.setApiKey",
        "title": "%multi-model-for-copilot.command.setApiKey%"
      },
      {
        "command": "multi-model-for-copilot.getApiKey",
        "title": "%multi-model-for-copilot.command.getApiKey%"
      },
      {
        "command": "multi-model-for-copilot.clearApiKey",
        "title": "%multi-model-for-copilot.command.clearApiKey%"
      },
      {
        "command": "multi-model-for-copilot.setMiMoApiKey",
        "title": "%multi-model-for-copilot.command.setMiMoApiKey%"
      },
      {
        "command": "multi-model-for-copilot.clearMiMoApiKey",
        "title": "%multi-model-for-copilot.command.clearMiMoApiKey%"
      },
      {
        "command": "multi-model-for-copilot.setQwenApiKey",
        "title": "%multi-model-for-copilot.command.setQwenApiKey%"
      },
      {
        "command": "multi-model-for-copilot.clearQwenApiKey",
        "title": "%multi-model-for-copilot.command.clearQwenApiKey%"
      },
      {
        "command": "multi-model-for-copilot.resetBaseUrl",
        "title": "%multi-model-for-copilot.command.resetBaseUrl%"
      },
      {
        "command": "multi-model-for-copilot.addCustomModel",
        "title": "%multi-model-for-copilot.command.addCustomModel%"
      },
      {
        "command": "multi-model-for-copilot.removeCustomModel",
        "title": "%multi-model-for-copilot.command.removeCustomModel%"
      },
      {
        "command": "multi-model-for-copilot.discoverModels",
        "title": "%multi-model-for-copilot.command.discoverModels%"
      },
      {
        "command": "multi-model-for-copilot.setVisionModel",
        "title": "%multi-model-for-copilot.command.setVisionModel%"
      },
      {
        "command": "multi-model-for-copilot.openSettings",
        "title": "%multi-model-for-copilot.command.openSettings%"
      },
      {
        "command": "multi-model-for-copilot.showLogs",
        "title": "%multi-model-for-copilot.command.showLogs%"
      },
      {
        "command": "multi-model-for-copilot.openRequestDumpsFolder",
        "title": "%multi-model-for-copilot.command.openRequestDumpsFolder%"
      },
      {
        "command": "multi-model-for-copilot.refreshBalance",
        "title": "%multi-model-for-copilot.command.refreshBalance%"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%multi-model-for-copilot.walkthrough.title%",
        "description": "%multi-model-for-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%multi-model-for-copilot.walkthrough.setApiKey.title%",
            "description": "%multi-model-for-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:multi-model-for-copilot.setApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%multi-model-for-copilot.walkthrough.showModels.title%",
            "description": "%multi-model-for-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%multi-model-for-copilot.walkthrough.advancedSettings.title%",
            "description": "%multi-model-for-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%multi-model-for-copilot.config.title%",
      "properties": {
        "multi-model-for-copilot.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "markdownDescription": "%multi-model-for-copilot.config.baseUrl.description%"
        },
        "multi-model-for-copilot.mimoBaseUrl": {
          "type": "string",
          "default": "https://token-plan-cn.xiaomimimo.com/v1",
          "markdownDescription": "%multi-model-for-copilot.config.mimoBaseUrl.description%"
        },
        "multi-model-for-copilot.qwenBaseUrl": {
          "type": "string",
          "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "markdownDescription": "%multi-model-for-copilot.config.qwenBaseUrl.description%"
        },
        "multi-model-for-copilot.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%multi-model-for-copilot.config.requestHeaders.description%"
        },
        "multi-model-for-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%multi-model-for-copilot.config.maxTokens.description%"
        },
        "multi-model-for-copilot.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%multi-model-for-copilot.config.experimental.stabilizeToolList.description%",
          "tags": [
            "experimental"
          ]
        },
        "multi-model-for-copilot.modelIdOverrides": {
          "type": "object",
          "default": {
            "deepseek-v4.1-flash": "deepseek-flash",
            "deepseek-v4-flash": "deepseek-v4-flash",
            "deepseek-v4-pro": "deepseek-v4-pro",
            "deepseek-v4-flash-vision-exp": "deepseek-v4-flash-vision-exp",
            "mimo-v2.5-pro": "mimo-v2.5-pro",
            "mimo-v2.5": "mimo-v2.5",
            "qwen-max": "qwen-max",
            "qwen-plus": "qwen-plus",
            "qwen-turbo": "qwen-turbo",
            "qwen-vl-max": "qwen-vl-max",
            "qwen-vl-plus": "qwen-vl-plus",
            "qwen-vl-turbo": "qwen-vl-turbo"
          },
          "description": "%multi-model-for-copilot.config.modelIdOverrides.description%",
          "additionalProperties": false,
          "properties": {
            "deepseek-v4.1-flash": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.deepseek-v4.1-flash.description%"
            },
            "deepseek-v4-flash": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.deepseek-v4-flash.description%"
            },
            "deepseek-v4-pro": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.deepseek-v4-pro.description%"
            },
            "deepseek-v4-flash-vision-exp": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.deepseek-v4-flash-vision-exp.description%"
            },
            "mimo-v2.5-pro": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.mimo-v2.5-pro.description%"
            },
            "mimo-v2.5": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.mimo-v2.5.description%"
            },
            "qwen-max": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-max.description%"
            },
            "qwen-plus": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-plus.description%"
            },
            "qwen-turbo": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-turbo.description%"
            },
            "qwen-vl-max": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-vl-max.description%"
            },
            "qwen-vl-plus": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-vl-plus.description%"
            },
            "qwen-vl-turbo": {
              "type": "string",
              "description": "%multi-model-for-copilot.config.modelIdOverrides.qwen-vl-turbo.description%"
            }
          }
        },
        "multi-model-for-copilot.customModels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl",
              "modelId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique model identifier"
              },
              "name": {
                "type": "string",
                "description": "Display name in model picker"
              },
              "baseUrl": {
                "type": "string",
                "description": "API base URL (e.g. https://api.example.com/v1)"
              },
              "modelId": {
                "type": "string",
                "description": "Model ID sent in API request"
              },
              "authHeader": {
                "type": "string",
                "default": "Authorization",
                "description": "Auth header name"
              },
              "authPrefix": {
                "type": "string",
                "default": "Bearer ",
                "description": "Prefix before API key (e.g. 'Bearer ' or '')"
              },
              "maxInputTokens": {
                "type": "number",
                "default": 128000
              },
              "maxOutputTokens": {
                "type": "number",
                "default": 8192
              },
              "toolCalling": {
                "default": false,
                "description": "Tool calling support (true/false or number)"
              },
              "imageInput": {
                "type": "boolean",
                "default": false
              },
              "thinking": {
                "type": "boolean",
                "default": false
              },
              "requiresThinkingParam": {
                "type": "boolean",
                "default": false
              },
              "useMaxCompletionTokens": {
                "type": "boolean",
                "default": false,
                "description": "Use max_completion_tokens instead of max_tokens"
              },
              "detail": {
                "type": "string",
                "description": "Short description shown in model picker"
              }
            }
          },
          "markdownDescription": "%multi-model-for-copilot.config.customModels.description%"
        },
        "multi-model-for-copilot.visionModel": {
          "type": "string",
          "default": "",
          "tags": [
            "advanced"
          ],
          "markdownDescription": "%multi-model-for-copilot.config.visionModel.description%"
        },
        "multi-model-for-copilot.visionPrompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "Text extraction is mandatory. Visual description required except T2.5. See OUTPUT FORMAT.\n\n---\n\nTASK 1 - TEXT EXTRACTION (always):\n\n1. Transcribe every detectable character verbatim - all text, symbols, and glyphs of any kind, in any location. Never correct, alter, summarize, paraphrase, or truncate the source.\n\n2. Preserve formatting and spatial grouping:\n   - Monospaced → code block (hint if known). Triple backticks in source → 4-backtick fence.\n   - Proportional → plain text, paragraph breaks.\n   - Tabular → Markdown table.\n   - Ambiguous → code block.\n\n3. Annotate spatial position:\n   - Isolated elements: label + colon.\n   - Multi-region: `[Region: name]` headers (avoids T1.4 collision).\n     [Region: name]\n     (content)\n\n4. Uncertainty markers (place at position):\n   [?] = uncertain char.\n   [unclear] = uncertain span.\n   [possible-artifact] = may not be text.\n   [unreadable] = illegible.\n   [truncated] = cut off at edge (place after last readable char).\n   Never guess or fabricate. If source contains a marker literally, backslash-escape it.\n\n5. Low-quality image: place after `--- Extracted Text ---`, before code block or transcription:\n   (Low image quality - confidence reduced.)\n\n6. No text: output \"No text detected.\" No code block, no other text.\n\n---\n\nTASK 2 - VISUAL DESCRIPTION (unless T2.5):\n\n1. Describe all non-text visual content.\n\n2. Text-heavy: describe application, window chrome, UI state, and color coding.\n\n3. Visual-primary: describe concisely but fully. Note color coding. Do not invent.\n\n4. Diagrams: describe structure - what labels represent, how elements connect. Diagram should be understandable from both sections.\n\n5. Omit Visual Context only for tightly cropped text. If any visual element beyond text is visible, include.\n\n---\n\nMULTIPLE IMAGES:\n\n- Label \"Image 1:\", \"Image 2:\", etc. Single image: skip label.\n- Combined summary only if images are related. If unsure, skip.\n\n---\n\nOUTPUT FORMAT:\n\nSingle image:\n--- Extracted Text ---\n[transcription]\n--- Visual Context ---\n[description]\n\nIf Visual Context omitted (T2.5), drop it.\n\nMultiple images (repeat for each):\nImage 1:\n--- Extracted Text ---\n[transcription]\n--- Visual Context ---\n[description]\n\n--- Combined Summary ---\n[summary - if applicable]\n\n---\n\nSPECIAL CASES:\n\n- Handwriting: best-effort; prepend \"(Handwriting - lower confidence.)\".\n- RTL: preserve direction; note in Visual Context.\n- Overlapping layers: extract all; flag [Foreground:] / [Background:].\n- Color: describe scheme in Visual Context only. Never encode in Extracted Text.\n- Image-in-image: treat as flat; note nesting in Visual Context.\n- Long lines: transcribe fully, no wrap; note overflow in Visual Context.\n\n---\n\nESCAPING - if source text contains a line exactly matching any format marker, backslash-escape it:\n\n- \\--- Extracted Text ---\n- \\--- Visual Context ---\n- \\--- Combined Summary ---\n- \\Image N: (standalone line immediately before a `---` marker)\n\nIf source contains any T1.4 marker literally, backslash-escape it.",
          "markdownDescription": "%multi-model-for-copilot.config.visionPrompt.description%"
        },
        "multi-model-for-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%multi-model-for-copilot.config.debugMode.minimal.label%",
            "%multi-model-for-copilot.config.debugMode.metadata.label%",
            "%multi-model-for-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%multi-model-for-copilot.config.debugMode.minimal.description%",
            "%multi-model-for-copilot.config.debugMode.metadata.description%",
            "%multi-model-for-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%multi-model-for-copilot.config.debugMode.description%"
        },
        "multi-model-for-copilot.statusBar.balance": {
          "type": "boolean",
          "default": true,
          "description": "%multi-model-for-copilot.config.statusBar.balance.description%"
        },
        "multi-model-for-copilot.statusBar.tokenSpeed": {
          "type": "boolean",
          "default": true,
          "description": "%multi-model-for-copilot.config.statusBar.tokenSpeed.description%"
        },
        "multi-model-for-copilot.showPricingNotice": {
          "type": "boolean",
          "default": true,
          "description": "%multi-model-for-copilot.config.showPricingNotice.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "vscode:prepublish": "bash .github/scripts/prepare-marketplace-readme.sh && npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "lint": "oxlint",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "package": "vsce package --readme-path dist/README.marketplace.md -o dist/",
    "login": "vsce login Vizards"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "ovsx": "0.10.12",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
